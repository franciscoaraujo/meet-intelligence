# ==============================================================================
# MEETING INTELLIGENCE - CONFIGURAÇÕES DE AMBIENTE (.env)
# ==============================================================================

# BANCO DE DADOS (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=meet_intelligence
DB_USER=meet_user
DB_PASSWORD=meet_secure_password

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6389

# RABBITMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5675
RABBITMQ_USER=meet_admin
RABBITMQ_PASSWORD=meet_rabbit_password

# OBJECT STORAGE (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password
S3_BUCKET_NAME=meet-recordings
S3_REGION=us-east-1

# SEGURANÇA (spec 007): nunca reutilize valores de exemplo; gere os seus.
# JWT_SECRET: no mínimo 32 caracteres aleatórios. Ex.: openssl rand -base64 48
# Vazio: o backend gera um segredo aleatório a cada início (os logins caem quando ele reinicia).
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
# APP_ENCRYPTION_KEY: 32 bytes em base64 que criptografam as chaves de IA no banco. Obrigatória.
# Ex.: openssl rand -base64 32. Guarde com cuidado: sem ela, as chaves gravadas não podem ser lidas.
APP_ENCRYPTION_KEY=
# Origens do frontend autorizadas (CORS e WebSocket), separadas por vírgula
APP_ALLOWED_ORIGINS=http://localhost:5173
# Login de demonstração (só o e-mail fixo). Nunca ligar em produção.
AUTH_DEMO_LOGIN_ENABLED=false

# GOOGLE OAUTH 2.0 & APIS
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# PROVEDORES SPEECH-TO-TEXT
DEEPGRAM_API_KEY=sua-chave-deepgram
# true: as chaves do servidor (Deepgram primeiro) vêm antes das chaves cadastradas pela organização (spec 018)
SPEECH_SERVER_KEYS_FIRST=true
OPENAI_API_KEY=sua-chave-openai
GOOGLE_CLOUD_API_KEY=sua-chave-gcp-stt

# PROVEDORES DE IA (LLM)
GEMINI_API_KEY=sua-chave-gemini
XAI_API_KEY=sua-chave-xai
ANTHROPIC_API_KEY=sua-chave-anthropic
# GEMINI, GROK ou CLAUDE (comentário em linha própria: o backend lê este formato e incluiria o texto no valor)
DEFAULT_LLM_PROVIDER=GEMINI
